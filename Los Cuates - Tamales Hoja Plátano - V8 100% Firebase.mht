@charset "utf-8";

:root { --bg: #f8f5ee; --card: #fff; --shadow: 12px 12px 24px #e6dfd1,-12px -12px 24px #ffffff; --shadow-in: inset 6px 6px 12px #e6dfd1,inset -6px -6px 12px #ffffff; --terra: #D86A3A; --verde: #4A7C59; --maiz: #E8C36A; --azul: #1e3a5f; --text: #2e2a24; }

* { box-sizing: border-box; margin: 0px; padding: 0px; font-family: "Segoe UI", system-ui, sans-serif; }

body { background-position-x: ; background-position-y: ; background-repeat: ; background-attachment: ; background-origin: ; background-clip: ; background-color: ; color: var(--text); background-image: radial-gradient(rgb(230, 223, 209) 0.5px, transparent 0.5px); background-size: 12px 12px; }

#splash { position: fixed; inset: 0px; background: var(--bg); z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 0.6s; }

.logo-circle { width: 150px; height: 150px; border-radius: 50%; background: var(--card); box-shadow: var(--shadow); display: grid; place-items: center; animation: 1.2s ease 0s infinite alternate none running zoom; padding: 10px; }

.logo-circle img { width: 100%; height: 100%; object-fit: contain; border-radius: 50%; }

@keyframes zoom { 
  0% { transform: scale(0.92); }
  100% { transform: scale(1.06); }
}

.bar { width: 220px; height: 10px; background: rgb(230, 223, 209); border-radius: 20px; overflow: hidden; margin-top: 22px; box-shadow: var(--shadow-in); }

.bar > div { height: 100%; background: linear-gradient(90deg,var(--terra),var(--maiz)); width: 0%; transition: width 0.1s; }

.badge { margin-top: 14px; background: var(--azul); color: rgb(255, 255, 255); padding: 6px 14px; border-radius: 20px; font-size: 11px; letter-spacing: 1px; font-weight: 800; }

header { max-width: 1100px; margin: 0px auto; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0px; z-index: 100; background: rgba(248, 245, 238, 0.9); backdrop-filter: blur(12px); }

.h-card { background: var(--card); box-shadow: var(--shadow); border-radius: 18px; padding: 10px 16px; display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 13px; }

.h-card img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }

.grid { max-width: 1100px; margin: 0px auto; padding: 12px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }

.card { background: var(--card); border-radius: 26px; box-shadow: var(--shadow); padding: 20px; transition: transform 0.2s; }

.card:active { transform: scale(0.98); }

.emoji { font-size: 58px; text-align: center; display: block; filter: drop-shadow(rgba(0, 0, 0, 0.12) 0px 8px 12px); }

.price { font-size: 22px; font-weight: 900; text-align: center; margin: 8px 0px; color: var(--terra); }

.qty { display: flex; justify-content: center; gap: 14px; align-items: center; margin-top: 12px; }

.qty button { width: 48px; height: 48px; border-radius: 50%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: var(--bg); box-shadow: var(--shadow); font-size: 22px; font-weight: 900; cursor: pointer; }

.qty button:active { box-shadow: var(--shadow-in); }

.section { max-width: 1100px; margin: 20px auto; padding: 0px 14px; }

.box { background: var(--card); box-shadow: var(--shadow); border-radius: 22px; padding: 20px; }

#map { height: 280px; border-radius: 18px; box-shadow: var(--shadow-in); margin-top: 12px; }

.cart { position: sticky; bottom: 0px; z-index: 200; background: rgba(248, 245, 238, 0.92); backdrop-filter: blur(12px); padding: 12px; border-top: 1px solid rgb(230, 223, 209); }

.cart-inner { max-width: 1100px; margin: 0px auto; background: var(--card); box-shadow: var(--shadow); border-radius: 20px; padding: 14px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center; }

.btn { background: var(--terra); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 14px 22px; border-radius: 14px; font-weight: 900; cursor: pointer; box-shadow: rgba(216, 106, 58, 0.3) 0px 8px 18px; }

.btn:active { transform: scale(0.96); }

.btn2 { background: var(--azul); color: rgb(255, 255, 255); }

input, select, textarea { width: 100%; padding: 12px 14px; border-radius: 14px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: var(--bg); box-shadow: var(--shadow-in); margin-top: 8px; font-size: 14px; }

#adminModal { display: none; position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.55); z-index: 10000; align-items: center; justify-content: center; padding: 10px; }

#adminModal.active { display: flex; }

.admin-box { background: var(--card); border-radius: 22px; max-width: 860px; width: 100%; max-height: 92vh; overflow: auto; padding: 20px; box-shadow: var(--shadow); }

.tab { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0px; }

.tab button { padding: 10px 14px; border-radius: 14px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: var(--bg); box-shadow: var(--shadow); font-weight: 800; cursor: pointer; font-size: 12px; }

.tab button.active { background: var(--terra); color: rgb(255, 255, 255); }

.ad-preview { border: 2px dashed rgb(209, 199, 181); border-radius: 16px; overflow: hidden; background: rgb(255, 255, 255); display: grid; place-items: center; aspect-ratio: 1 / 1; position: relative; }

.kpi { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin: 12px 0px; }

.kpi div { background: var(--card); box-shadow: var(--shadow); border-radius: 18px; padding: 14px; text-align: center; }

.kpi b { font-size: 22px; color: var(--terra); display: block; }

.qrbox { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }

.qrbox img { border-radius: 12px; box-shadow: var(--shadow); }

.footer { max-width: 1100px; margin: 30px auto; padding: 20px; text-align: center; }

.footer .jm-logo { width: 54px; height: 54px; border-radius: 50%; box-shadow: var(--shadow); cursor: pointer; transition: transform 0.2s; object-fit: cover; background: rgb(0, 0, 0); }

.footer .jm-logo:active { transform: scale(1.2); }

.pagos-preview { background: var(--bg); box-shadow: var(--shadow-in); border-radius: 14px; padding: 12px; font-size: 12px; margin-top: 10px; }
