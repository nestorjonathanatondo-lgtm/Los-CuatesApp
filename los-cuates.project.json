{
  "name": "Los Cuates App",
  "version": "9.0.0",
  "locale": "es-MX",
  "type": "minisuper-orders",
  "features": {
    "adminLogoManagement": true,
    "productCreateDelete": true,
    "promotionCreateDelete": true,
    "promotionQrScanner": true,
    "scheduledOrders": { "enabled": true, "maxMonthsAhead": 2 },
    "editableOrderTerms": true,
    "letterheadTicket": { "enabled": true, "watermarkOpacity": 0.2, "brand": "Los Cuates" }
  },
  "adminAccess": { "trigger": "footer-logo", "passwordConfigured": true },
  "storage": { "primary": "Neon Postgres", "tables": ["app_customers", "app_orders", "app_settings"], "offlineFallback": "localStorage" },
  "branding": { "primary": "terracotta", "secondary": "banana-green", "accent": "maize", "style": "contemporary-mexican-minimarket" }
}
